# App
APP_NAME=AI API Platform
APP_VERSION=1.0.0
APP_DESCRIPTION=Production-ready OpenAI-compatible API for self-hosted LLMs
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-at-least-64-chars

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_api
DATABASE_SYNC_URL=postgresql://user:password@localhost:5432/ai_api

# LM Studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# 0 disables the response read timeout for slow local inference.
LM_STUDIO_READ_TIMEOUT=0
LM_STUDIO_CONNECT_TIMEOUT=10
LM_STUDIO_WRITE_TIMEOUT=30
LM_STUDIO_POOL_TIMEOUT=10
LM_STUDIO_DEFAULT_MAX_TOKENS=4096
LM_STUDIO_CONTEXT_LENGTH=8192
LM_STUDIO_AUTO_EVICT_OTHER_MODELS=true
INFERENCE_CONCURRENCY=1
INFERENCE_QUEUE_SIZE=20
INFERENCE_QUEUE_WAIT_TIMEOUT=900

# API Keys
API_KEY_PREFIX=sk_live_
API_KEY_BYTES=32
API_KEY_HASH_ALGORITHM=sha256

# Rate Limiting
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60

# Quotas
DEFAULT_DAILY_REQUESTS=10000
DEFAULT_MONTHLY_REQUESTS=300000
DEFAULT_DAILY_TOKENS=10000000
DEFAULT_MONTHLY_TOKENS=300000000

# CORS
CORS_ORIGINS=*

# Ngrok (for exposing local server to the internet)
NGROK_URL=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# Security
BCRYPT_ROUNDS=12
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis (optional, for rate limiting)
REDIS_URL=

# Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=changeme123
